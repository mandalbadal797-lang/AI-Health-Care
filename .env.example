# Application Environment & Debug Settings
APP_NAME=MindCampus API
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# Security & Authentication Settings
# IMPORTANT: Generate a strong secret key for production (e.g. openssl rand -hex 32)
SECRET_KEY=dev_secret_key_change_in_production_9f8e7d6c5b4a321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection (SQLite local dev default, PostgreSQL in prod)
DATABASE_URL=sqlite+aiosqlite:///./mindcampus_dev.db

# AI Provider API Configuration (Backend Only)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Media Upload Directory
UPLOAD_DIR=backend/static/uploads
